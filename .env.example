# --- LLM providers (free tiers work) ---
GROQ_API_KEY=your_groq_api_key
# GEMINI_API_KEY is read first; GOOGLE_API_KEY also works.
GEMINI_API_KEY=your_gemini_api_key

# --- LangSmith tracing (free Developer plan is enough) ---
# Set LANGSMITH_TRACING=true to send every graph run, node and LLM call to
# LangSmith, tagged with role (classify/generate/judge), provider and mode.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=agentic-llm-router

# --- Benchmarking ---
# Enables fault injection (fail_provider) and POST /cache/clear, /metrics/reset.
# Keep false outside benchmark runs.
BENCHMARK_MODE=false
